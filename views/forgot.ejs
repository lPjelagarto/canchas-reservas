<%- include('partials/header') %>
<section class="card narrow">
  <h2>Recuperar contraseña</h2>
  <% if (sent) { %>
    <div class="alert ok">Si el correo está registrado, te enviamos un enlace para crear una nueva contraseña. Revisa también la carpeta de spam. El enlace vence en 1 hora.</div>
    <p class="muted"><a href="/login">Volver a iniciar sesión</a></p>
  <% } else { %>
    <p class="muted">Escribe tu correo y te enviaremos un enlace para restablecerla.</p>
    <form method="post" action="/olvide-contrasena">
      <label>Correo electrónico
        <input type="email" name="email" required autofocus>
      </label>
      <button class="btn" type="submit">Enviar enlace</button>
    </form>
    <p class="muted"><a href="/login">Volver</a></p>
  <% } %>
</section>
<%- include('partials/footer') %>
